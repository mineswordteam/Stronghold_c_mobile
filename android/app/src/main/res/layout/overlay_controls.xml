<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Left Pause & Menu Overlay Button -->
    <ImageButton
        android:id="@+id/btnPauseMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="#80000000"
        android:contentDescription="Pause Menu"
        android:src="@android:drawable/ic_menu_preferences"
        android:tint="#DAA520" />

    <!-- Right Side Context Control Cluster -->
    <LinearLayout
        android:id="@+id/controlCluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnLeftClick"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="SELECT"
            android:textSize="10sp"
            android:backgroundTint="#8B0000"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnRightClick"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="ACTION"
            android:textSize="10sp"
            android:backgroundTint="#DAA520"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBoxSelect"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="DRAG"
            android:textSize="10sp"
            android:backgroundTint="#3A281C"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</RelativeLayout>
